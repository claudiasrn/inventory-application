    <%- include("partials/header") %>
    <main>
        <a href="/suppliers">All suppliers</a>
        <h2><%= heading %></h2>
        <% if (errors.length > 0) { %>
            <ul class="errors">
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
        <form method="post" action="<%= formAction %>">
            <div class="field">
                <label for="name">Name</label>
                <input type="text" name="name" id="name" required maxlength="100" value="<%= supplier.name %>">
            </div>
            <div class="field">
                <label for="contact_email">Contact email</label>
                <input type="email" name="contact_email" id="contact_email" value="<%= supplier.contact_email %>">
            </div>
            <div class="field">
                <label for="country">Country</label>
                <input type="text" name="country" id="country" value="<%= supplier.country %>">
            </div>
            <div class="field">
                <label for="password">Admin password</label>
                <input type="password" name="password" id="password" required>
            </div>
            <button type="submit"><%= submitLabel %></button>
            <a href="/suppliers">Cancel</a>
        </form>
    </main>
</body>
</html>