    <%- include("partials/header") %>
    <main>
        <a href="/categories" class="back">All categories</a>
        <div class="top-part">
            <h2><%= category.name %></h2>
            <div class="actions">
                <a href="/categories/<%= category.id %>/edit">Edit</a>
                <a href="/categories/<%= category.id %>/delete">Delete</a>
            </div>
        </div>

        <p><%= category.description %></p>
        <% if (items.length === 0) { %>
            <div class="empty">
                <p>No items in this category yet</p>
                <p>Add the first one to start tracking stock.</p>
            </div>
        <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Price</th>
                            <th scope="col">Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach((item) => { %>
                            <tr>
                                <td><a href="/items/<%= item.id %>"><%= item.name %></a></td>
                                <td><%= item.price %>€</td>
                                <td><%= item.stock %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
        <a href="/items/new?category=<%= category.id %>">+ New item in this category</a>
    </main>
</body>
</html>