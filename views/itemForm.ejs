    <%- include("partials/header") %>
    <main>
        <a href="/items">All items</a>
        <h2><%= heading %></h2>
        <% if (errors.length > 0) { %>
            <ul class="errors">
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
        <form method="post" action="<%= formAction %>">
            <div class="field">
                <label for="name">Name</label>
                <input type="text" name="name" id="name" required maxlength="100" value="<%= item.name %>">
            </div>
            <div class="field">
                <label for="description">Description</label>
                <textarea name="description" id="description" rows="3"><%= item.description %></textarea>
            </div>
            <div class="field">
                <label for="price">Price</label>
                <input type="number" name="price" id="price" required min="0" step="0.01" value="<%= item.price %>">
            </div>
            <div class="field">
                <label for="stock">Stock</label>
                <input type="number" name="stock" id="stock" required min="0" step="1" value="<%= item.stock %>">
            </div>
            <div class="field">
                <label for="category_id">Category</label>
                <select name="category_id" id="category_id" required>
                    <option value="">Choose a category…</option>
                    <% categories.forEach((category) => { %>
                        <option value="<%= category.id %>" <%= String(category.id) === String(item.category_id) ? "selected" : "" %>><%= category.name %></option>
                    <% }) %>
                </select>
            </div>
            <button type="submit"><%= submitLabel %></button>
            <a href="/items">Cancel</a>
        </form>
    </main>
</body>
</html>