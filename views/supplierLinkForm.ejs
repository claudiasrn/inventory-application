    <%- include("partials/header") %>
    <main>
        <a href="/suppliers/<%= supplier.id %>"><%= supplier.name %></a>
        <h2>Link an item</h2>
        <p>Record what <%= supplier.name %> supplies and at what price.</p>
        <% if (errors.length > 0) { %>
            <ul class="errors">
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
        <% if (items.length === 0) { %>
            <div class="empty">
                <p>No items left to link</p>
                <p>Every item is already linked to this supplier.</p>
            </div>
        <% } else { %>
            <form method="post" action="/suppliers/<%= supplier.id %>/link">
                <div class="field">
                    <label for="item_id">Item</label>
                    <select name="item_id" id="item_id" required>
                        <option value="">Choose an item…</option>
                        <% items.forEach((item) => { %>
                            <option value="<%= item.id %>" <%= String(item.id) === String(link.item_id) ? "selected" : "" %>><%= item.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field">
                    <label for="wholesale_price">Wholesale price</label>
                    <input type="number" name="wholesale_price" id="wholesale_price" required min="0" step="0.01" value="<%= link.wholesale_price %>">
                </div>
                <button type="submit">Link item</button>
                <a href="/suppliers/<%= supplier.id %>">Cancel</a>
            </form>
        <% } %>
    </main>
</body>
</html>